{
  "name": "agent-hub-monorepo",
  "version": "1.0.0",
  "description": "Plataforma Multi-Stack, Multi-Platform & Multi-LLM (OmniRoute) Squad de Engenharia Autônoma",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev:api": "pnpm --filter @agent-hub/api dev",
    "dev:web": "pnpm --filter @agent-hub/web dev",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @agent-hub/api build",
    "build:web": "pnpm --filter @agent-hub/web build",
    "db:migrate": "pnpm --filter @agent-hub/api prisma:migrate",
    "db:generate": "pnpm --filter @agent-hub/api prisma:generate",
    "db:studio": "pnpm --filter @agent-hub/api prisma:studio",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
