# ============================================================================
# 1. BANCO DE DADOS E PORTAS (Dedicadas para não conflitar com agent-backend)
# ============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agent_hub_db
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/agent_hub_db?schema=public"

PORT=3334
VITE_API_URL=http://localhost:3334
VITE_WS_URL=ws://localhost:3334

# Caminho dos repositórios locais e worktrees isoladas
HOST_REPOS_PATH=/home/nlnadialigia
REPOS_BASE_DIR=/workspace/repos
WORKTREES_BASE_DIR=/workspace/worktrees

# ============================================================================
# 2. SEGURANÇA DO COFRE DE CREDENCIAIS (AES-256)
# ============================================================================
VAULT_SECRET_KEY=agent_hub_super_secret_vault_key_2026_32bytes!

# ============================================================================
# 3. GATEWAY MULTI-LLM OMNIROUTE & CHAVE PAGA DO TECH LEAD
# ============================================================================
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=sk-omniroute-local

# Chave Paga do Google Gemini (Usada por padrão apenas pelo Tech Lead Orchestrator)
GEMINI_API_KEY=

# Catálogo Inicial (Seed) de Modelos Autorizados (Free + Pago do Tech Lead)
ALLOWED_PAID_MODELS=gemini-2.5-pro
ALLOWED_FREE_MODELS=deepseek-v3-free,deepseek-r1-free,qwen-2.5-coder-free,gemini-2.5-pro-free,gemini-2.5-flash-free,llama-3.3-70b-groq,auto

# ============================================================================
# 4. INTEGRAÇÕES DE BOARDS E GIT (Podem ser gerenciadas na aba Configurações)
# ============================================================================
# GitHub (Issues + Pull Requests -> default branch: main)
GITHUB_TOKEN=

# Kanbanize / Businessmap (Cards + Sincronização automática de Subtasks v2)
KANBANIZE_SUBDOMAIN=
KANBANIZE_API_KEY=

# Azure DevOps (Pull Requests -> default branch: develop)
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_TOKEN=

# Opcionais (Jira, Trello, Linear, GitLab, Bitbucket)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
TRELLO_API_KEY=
TRELLO_TOKEN=
LINEAR_API_KEY=
GITLAB_TOKEN=
BITBUCKET_TOKEN=
